# Copy to .env, ignored by Git. Choose a local-only password.
POSTGRES_PASSWORD=replace-with-your-own-local-password
ConnectionStrings__Database=Host=localhost;Port=55432;Database=careergap;Username=careergap;Password=replace-with-your-own-local-password
ASPNETCORE_ENVIRONMENT=Development
# Production object storage (Cloudflare R2 S3-compatible API — never put real keys in Git):
# Storage__Provider=S3
# Storage__Endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Storage__Bucket=careergapai-private
# Storage__AccessKey=<32-char R2 S3 Access Key ID>
# Storage__SecretKey=<64-char R2 S3 Secret Access Key>
# Storage__Region=auto
# Real providers are disabled by default. Never put keys in VITE_*.
# Matching: paid calls also require the existing provider/budget/pricing settings.
# Ai__FullCvMaxOutputTokens=8192
# Ai__MatchMaxOutputTokens=4096
# Ai__WritingMaxOutputTokens=2048
# Ai__UserPeriodLimit=0.25
# Ai__UserMaxActiveJobs=3
# The account limit is inside the shared cap, not extra money. Keep the development
# ledger across all databases/environments; never reset its 2 USD authorization.

# Optional adapters have bounded localhost evidence; defaults still stay Fake.
# Existing keys or past probes do not grant new quota: verify the current allowance/window.
Search__Provider=Fake
Email__Provider=Fake
# Search__ApiKey= backend only; do not put a real value in this example
# Search__CreditLimit=0
# Search__UserCreditLimit=0
# Search__PeriodStart= ISO UTC confirmed provider window
# Search__PeriodEnd= ISO UTC confirmed provider window
# Search__CreditsVerifiedAt= ISO UTC
# Search__MetadataCacheMinutes=0
# Search__CacheTermsVerified=false
# Email__ApiKey= backend only
# Email__Sender= verified sender email
# Email__SenderVerified=false
# Email__TestRecipient= owner-controlled recipient for local verification
# Email__DeliveryLimit=0
# Email__PeriodStart= ISO UTC confirmed provider window
# Email__PeriodEnd= ISO UTC confirmed provider window
# Email__LimitsVerifiedAt= ISO UTC
