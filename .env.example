# Copy to .env, ignored by Git. Choose a local-only password.
POSTGRES_PASSWORD=replace-with-your-own-local-password
ConnectionStrings__Database=Host=localhost;Port=55432;Database=careergap;Username=careergap;Password=replace-with-your-own-local-password
ASPNETCORE_ENVIRONMENT=Development
# Real providers are disabled by default. Never put keys in VITE_*.
# Matching: paid calls also require the existing provider/budget/pricing settings.
# Ai__MatchMaxOutputTokens=2048
# Ai__UserPeriodLimit=0.25
# Ai__UserMaxActiveJobs=3
# The account limit is inside the shared cap, not extra money. Keep the development
# ledger across all databases/environments; never reset its 2 USD authorization.
