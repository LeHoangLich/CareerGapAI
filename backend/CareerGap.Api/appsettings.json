{
  "Logging": { "LogLevel": { "Default": "Warning", "Microsoft.Hosting.Lifetime": "Information" } },
  "AllowedHosts": "localhost;127.0.0.1",
  "Storage": { "Provider": "Local", "Root": "../../.local/files" },
  "Ai": {
    "Provider": "Fake", "Enabled": true,
    "MonthlyLimit": 0, "InputUsdPerMillion": 0, "OutputUsdPerMillion": 0,
    "Model": "", "PricingVerifiedAt": "", "MaxInputTokens": 16000, "MaxOutputTokens": 512,
    "LeaseSeconds": 120, "PollSeconds": 15
  },
  "Matching": {
    "Baseline": {
      "MethodVersion": "weighted-keyword-overlap-v1",
      "DefaultTopK": 20,
      "MaximumTopK": 50,
      "MaximumQueryTerms": 500,
      "ExplanationTermCount": 8,
      "MinimumTokenLength": 2,
      "TitleWeight": 3,
      "RequirementsWeight": 2,
      "DescriptionWeight": 1,
      "StopWords": [
        "a", "an", "and", "are", "as", "at", "be", "by", "for", "from", "in", "into", "is", "it", "of", "on", "or", "our", "the", "to", "with", "you", "your",
        "va", "la", "cua", "cac", "cho", "co", "da", "de", "den", "duoc", "mot", "nhung", "tai", "theo", "trong", "tu", "voi", "va", "yeu", "cau"
      ]
    }
  }
}
