{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "CareerGap AI Design System",
    "version": "2.0.0",
    "style": "Editorial AI SaaS",
    "mode": "Light"
  },
  "color": {
    "primitive": {
      "forest": {
        "600": { "value": "#245C48", "type": "color" },
        "700": { "value": "#194735", "type": "color" },
        "800": { "value": "#143D2D", "type": "color" },
        "100": { "value": "#E8F4EC", "type": "color" },
        "200": { "value": "#C9DFCF", "type": "color" }
      },
      "neutral": {
        "0": { "value": "#FFFFFF", "type": "color" },
        "50": { "value": "#F7F8F4", "type": "color" },
        "100": { "value": "#F2F5EE", "type": "color" },
        "200": { "value": "#E9EDE5", "type": "color" },
        "300": { "value": "#DDE3DA", "type": "color" },
        "400": { "value": "#C5CFC2", "type": "color" },
        "500": { "value": "#6B776F", "type": "color" },
        "700": { "value": "#526057", "type": "color" },
        "900": { "value": "#1F2B24", "type": "color" }
      },
      "ai": {
        "50": { "value": "#EEF2F8", "type": "color" },
        "200": { "value": "#C7D6E8", "type": "color" },
        "600": { "value": "#2F5586", "type": "color" },
        "700": { "value": "#23426B", "type": "color" }
      },
      "amber": {
        "50": { "value": "#FBF5E6", "type": "color" },
        "700": { "value": "#846224", "type": "color" }
      },
      "crimson": {
        "50": { "value": "#FBEFEE", "type": "color" },
        "700": { "value": "#9E3B33", "type": "color" }
      }
    },
    "semantic": {
      "bg/canvas": { "value": "{color.primitive.neutral.50}", "cssVar": "var(--color-bg)" },
      "bg/surface": { "value": "{color.primitive.neutral.0}", "cssVar": "var(--color-surface)" },
      "bg/surface-subtle": { "value": "{color.primitive.neutral.100}", "cssVar": "var(--color-surface-subtle)" },
      "bg/ai-tint": { "value": "{color.primitive.ai.50}", "cssVar": "var(--color-ai-bg)" },
      "text/primary": { "value": "{color.primitive.neutral.900}", "cssVar": "var(--color-text-primary)" },
      "text/secondary": { "value": "{color.primitive.neutral.700}", "cssVar": "var(--color-text-secondary)" },
      "text/muted": { "value": "{color.primitive.neutral.500}", "cssVar": "var(--color-text-muted)" },
      "text/inverse": { "value": "{color.primitive.neutral.0}", "cssVar": "var(--color-text-inverse)" },
      "brand/primary": { "value": "{color.primitive.forest.600}", "cssVar": "var(--color-primary)" },
      "brand/primary-hover": { "value": "{color.primitive.forest.700}", "cssVar": "var(--color-primary-hover)" },
      "ai/accent": { "value": "{color.primitive.ai.600}", "cssVar": "var(--color-ai-accent)" },
      "ai/border": { "value": "{color.primitive.ai.200}", "cssVar": "var(--color-ai-border)" },
      "border/default": { "value": "{color.primitive.neutral.300}", "cssVar": "var(--color-border)" },
      "border/subtle": { "value": "{color.primitive.neutral.200}", "cssVar": "var(--color-border-subtle)" },
      "border/strong": { "value": "{color.primitive.neutral.400}", "cssVar": "var(--color-border-strong)" },
      "status/matched-bg": { "value": "{color.primitive.forest.100}", "cssVar": "var(--color-matched-bg)" },
      "status/matched-text": { "value": "#1F513B", "cssVar": "var(--color-matched-text)" },
      "status/partial-bg": { "value": "{color.primitive.amber.50}", "cssVar": "var(--color-partial-bg)" },
      "status/partial-text": { "value": "{color.primitive.amber.700}", "cssVar": "var(--color-partial-text)" },
      "status/gap-bg": { "value": "{color.primitive.crimson.50}", "cssVar": "var(--color-gap-bg)" },
      "status/gap-text": { "value": "{color.primitive.crimson.700}", "cssVar": "var(--color-gap-text)" }
    }
  },
  "spacing": {
    "1": { "value": 4, "type": "dimension" },
    "2": { "value": 8, "type": "dimension" },
    "3": { "value": 12, "type": "dimension" },
    "4": { "value": 16, "type": "dimension" },
    "5": { "value": 20, "type": "dimension" },
    "6": { "value": 24, "type": "dimension" },
    "8": { "value": 32, "type": "dimension" },
    "12": { "value": 48, "type": "dimension" }
  },
  "radius": {
    "sm": { "value": 6, "type": "dimension" },
    "md": { "value": 8, "type": "dimension" },
    "lg": { "value": 12, "type": "dimension" },
    "pill": { "value": 999, "type": "dimension" }
  }
}
